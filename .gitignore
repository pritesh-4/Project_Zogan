# =============================================================================
# 🐘 PROJECT ZOGAN — GIT IGNORE RULES
# =============================================================================

# Environments & Virtual Environments
venv/
.venv/
env/
ENV/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Linters cache
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Training runs & experiment outputs (regenerable artifacts)
runs/

# YOLO dataset cache files (auto-generated during training/validation)
*.cache

# Runtime alert event logs (generated at runtime)
logs/*.jsonl
*.jsonl
!logs/.gitkeep

# Generated prediction/comparison images (output artifacts)
predicted_*.jpg
comparison_*.jpg
test_output_*.jpg
*_hud_preview.jpg
*_tracking_preview.jpg

# Sensitive credentials & environment variables
.env
.env.*
*.env
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
credentials.json

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Log files
*.log
